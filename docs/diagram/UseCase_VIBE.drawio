asan &amp;amp; notifikasi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="447.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c29" value="Melihat data &amp;amp; detail mahasiswa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="503.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c30" value="Melihat nilai mahasiswa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="559.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c31" value="Memantau angkatan" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="615.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c32" value="Melihat kurikulum CPMK &amp;amp; program studi" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="671.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c33" value="Melihat data master (dengan izin)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="727.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c34" value="Melihat log aktivitas" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#1E293B;fontSize=13;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1650.0" y="783.0" width="310.0" height="46.0" as="geometry"/></mxCell><mxCell id="c35" value="Mengajukan perubah