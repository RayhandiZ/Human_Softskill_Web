olor=#334155;strokeWidth=1.3;" edge="1" parent="1" source="c8" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c95" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.3;" edge="1" parent="1" source="c8" target="c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c96" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.3;" edge="1" parent="1" source="c8" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c97" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.3;" edge="1" parent="1" source="c8" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c98" value="" style="endArrow=none;html=1;strokeColor=#334155;strokeWidth=1.3;" edge="1" parent="1" source="c8" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c99" value="«extend»" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c100" value="«extend»" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c101" value="«extend»&lt;br&gt;{sesudah ditolak / dicabut}" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c102" value="«extend»&lt;br&gt;{angkatan selesai/disahkan atau aspek final}" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c103" value="«extend»&lt;br&gt;{selama masih menunggu}" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c54" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c104" value="«include»" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c105" value="«include»" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c106" value="«include»" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c39" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c107" value="«include»" style="endArrow=open;endSize=12;dashed=1;dashPattern=8 5;html=1;strokeColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c40" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c108" value="&lt;i&gt;{hanya akun Mahasiswa &amp;amp; Dosen yang aktif}&lt;/i&gt;" style="text;html=1;fontSize=11;align=center;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1360.0" y="408.0" width="320.0" height="22.0" as="geometry"/></mxCell><mxCell id="c109" value="&lt;b&gt;Catatan:&lt;/b&gt;&lt;br&gt;1. Semua use case di dalam sistem mensyaratkan pengguna sudah Masuk (sesi aktif).&lt;br&gt;2. Super Admin mewarisi seluruh use case Admin (generalisasi).&lt;br&gt;3. Perubahan bobot, penilaian aspek, aspek CPMK, tanda final, pengesahan angkatan, dan akses data master dari Admin tidak langsung disimpan, tetapi diajukan ke Super Admin.&lt;br&gt;4. Koreksi nilai dan akses cetak sertifikat diputuskan dua lapis: Admin lalu Super Admin.&lt;br&gt;5. Wewenang Mahasiswa (koreksi, minta sertifikat), unggah nilai Dosen, dan baca log Admin bisa ditutup sementara oleh Super Admin lewat Peran &amp;amp; Wewenang." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700.0" y="1745.0" width="820.0" height="205.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>