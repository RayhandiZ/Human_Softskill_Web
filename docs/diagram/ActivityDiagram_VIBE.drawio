r=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580.0" y="2011.5"/><mxPoint x="210.0" y="2011.5"/></Array></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="Dosen hanya melihat mahasiswa di kelas dan angkatan yang diampunya (DosenKelas, DosenAngkatan). Sel kosong di berkas tidak menghapus nilai. Super Admin dapat membatalkan satu unggahan (rollback, AD-07)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090.0" y="492.5" width="290.0" height="95.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="AD-04" id="hal3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b&gt;AD-04 — Pengajuan Koreksi Nilai (Persetujuan Dua Lapis)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#475569"&gt;Mahasiswa mengajukan koreksi satu komponen nilai. Admin meneruskan atau menolak (lapis 1), lalu Super Admin menyetujui dan menerapkan nilainya atau menolak (lapis 2). Pengajuan tidak mengubah nilai sebelum disetujui.&lt;br&gt;&lt;font color="#64748B" style="font-size:12px"&gt;Rujukan kode: app/api/koreksi, app/api/koreksi/keputusan, src/server/pengajuan.js (ajukanKoreksi, putuskanKoreksi)&lt;/font&gt;&lt;/font&gt;' style="text;html=1;fontSize=24;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="18.0" width="1870.0" height="86.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Mahasiswa&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#DBEAFE;swimlaneFillColor=#EFF6FF;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="112.0" width="330.0" height="1908.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sistem VIBE&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360.0" y="112.0" width="600.0" height="1908.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Admin (lapis 1)&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FEF3C7;swimlaneFillColor=#FFFBEB;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="960.0" y="112.0" width="470.0" height="1908.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Super Admin (lapis 2)&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FFE4E6;swimlaneFillColor=#FFF1F2;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1430.0" y="112.0" width="470.0" height="1908.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;shape=startState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="183.0" y="206.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="c8" value="Membuka Transkrip dan memilih komponen yang ingin dikoreksi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="70.0" y="285.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c9" value="Menulis alasan dan nilai yang diharapkan (opsional), lalu mengirim pengajuan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="70.0" y="369.8" width="250.0" height="64.5" as="geometry"/></mxCell><mxCell id="c10" value="Pengajuan memenuhi syarat?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="410.0" y="460.3" width="240.0" height="67.4" as="geometry"/></mxCell><mxCell id="c11" value="Menolak dan menampilkan alasannya" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="700.0" y="469.5" width="220.0" height="49.0" as="geometry"/></mxCell><mxCell id="c12" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="796.0" y="572.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c13" value="Menyimpan PengajuanKoreksi (MENUNGGU_ADMIN) dan mencatat log AJUKAN_KOREKSI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="405.0" y="553.8" width="250.0" height="64.5" as="geometry"/></mxCell><mxCell id="c14" value="Membuka Nilai Mahasiswa › tab Pengajuan koreksi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="980.0" y="653.5" width="230.0" height="49.0" as="geometry"/></mxCell><mxCell id="c15" value="Diteruskan ke Super Admin?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="980.0" y="736.3" width="230.0" height="67.4" as="geometry"/></mxCell><mxCell id="c16" value="Menetapkan nilai usulan (0–100) dan catatan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="990.0" y="837.5" width="210.0" height="49.0" as="geometry"/></mxCell><mxCell id="c17" value="Menulis alasan penolakan (min. 10 karakter)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1220.0" y="837.5" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;A&lt;/b&gt;" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1305.0" y="939.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c19" value="Status MENUNGGU_SUPERADMIN; nilai usulan disimpan; log TERUSKAN_KOREKSI" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="405.0" y="921.8" width="250.0" height="64.5" as="geometry"/></mxCell><mxCell id="c20" value="Meninjau pengajuan beserta nilai usulan Admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1455.0" y="1021.5" width="220.0" height="49.0" as="geometry"/></mxCell><mxCell id="c21" value="Disetujui?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="1465.0" y="1108.0" width="200.0" height="60.0" as="geometry"/></mxCell><mxCell id="c22" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" verte