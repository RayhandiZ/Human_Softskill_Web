" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="[Ya]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c37"><mxGeometry relative="1" x="-0.6" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="[Tidak]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" x="-0.6" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630.0" y="2103.5"/><mxPoint x="170.0" y="2103.5"/></Array></mxGeometry></mxCell><mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="Syarat kelayakan bawaan: sudah menempuh Semester 3, seluruh aspek final, tidak ada komponen kosong, nilai akhir ≥ ambang (bawaan 70), dan nilai angkatan sudah disahkan; ditambah syarat tambahan dari Super Admin (Aturan Sistem)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1445.0" y="380.4" width="420.0" height="80.0" as="geometry"/></mxCell><mxCell id="c75" value="Sesudah ditolak atau dicabut, mahasiswa boleh mengajukan peninjauan cetak dengan penjelasan wajib (mulai lagi dari awal diagram ini)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60.0" y="1225.1" width="360.0" height="65.0" as="geometry"/></mxCell><mxCell id="c76" value="Admin atau Super Admin dapat mencabut akses yang sudah SIAP_DICETAK dengan alasan min. 10 karakter → status DICABUT (log CABUT_SERTIFIKAT). Admin juga dapat mencetak atas nama mahasiswa dari menu Cetak Sertifikat dengan pemeriksaan yang sama." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1105.0" y="1938.6" width="300.0" height="110.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="AD-06" id="hal5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1958" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b&gt;AD-06 — Persetujuan Permintaan Admin oleh Super Admin&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#475569"&gt;Tindakan Admin biasa yang perlu persetujuan tidak langsung disimpan, tetapi menjadi PermintaanAdmin. Gerbangnya dipasang di pintu API (denganPersetujuan), sehingga tidak bisa dilewati.&lt;br&gt;&lt;font color="#64748B" style="font-size:12px"&gt;Rujukan kode: src/server/persetujuan.js (denganPersetujuan, ajukanDalam, putuskanPermintaan, batalkanPermintaan)&lt;/font&gt;&lt;/font&gt;' style="text;html=1;fontSize=24;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="18.0" width="1500.0" height="86.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Admin&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FEF3C7;swimlaneFillColor=#FFFBEB;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="112.0" width="400.0" height="1816.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sistem VIBE&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="430.0" y="112.0" width="640.0" height="1816.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Super Admin&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FFE4E6;swimlaneFillColor=#FFF1F2;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1070.0" y="112.0" width="460.0" height="1816.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;html=1;shape=startState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="218.0" y="206.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="c7" value="Menjalankan tindakan yang digerbang (ubah bobot, penilaian aspek, aspek CPMK, tanda final, sahkan angkatan, akses data master)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="70.0" y="277.8" width="320.0" height="64.5" as="geometry"/></mxCell><mxCell id="c8" value="Menulis alasan (min. 10 karakter), lalu mengirim" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="100.0" y="377.5" width="260.0" height="49.0" as="geometry"/></mxCell><mxCell id="c9" value="Pengirim Super Admin?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="490.0" y="460.3" width="240.0" height="67.4" as="geometry"/></mxCell><mxCell id="c10" value="Tindakan langsung dijalankan dan dicatat di log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="800.0" y="469.5" width="240.0" height="49.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="906.0" y="572.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c12" value="Akses angkatan dan isi permintaan sah?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="480.0" y="644.3" width="260.0" height="67.4" as="geometry"/></mxCell><mxCell id="c13" value="Menolak dengan pesan; data tidak berubah" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="800.0" y="653.5" width="240.0" height="49.0" as="geometry"/></mxCell><mxCell id="c14" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="906.0" y="756.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c15" value="Menyimpan PermintaanAdmin (MENUNGGU) + ringkasan dampak; log AJUKAN_PERSETUJUAN; data belum berubah" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="460.0" y="737.8" width="300.0" height="64.5" as="geometry"/></mxCell><mxCell id="c16" value="Memantau permintaan di menu Permintaan Saya" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="100.0" y="837.5" width="260.0" height="49.0" as="geometry"/></mxCell><mxCell id="c17" value="Menarik permintaan sebelum diputuskan?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="105.0" y="920.3" width="250.0" height="67.4" as="geometry"/></mxCell><mxCell id="c18" value="Status DIBATALKAN; log TARIK_PERMINTAAN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="485.0" y="1021.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c19" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="906.0" y="1032.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c20" value="Membuka Persetujuan dan membaca ringkasan dampak" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1095.0" y="1113.5" width="230.0" height="49.0" as="geometry"/></mxCell><mxCell id="c21" value="Keputusan?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="1110.0" y="1200.0" width="200.0" height="60.0" as="geometry"/></mxCell><mxCell id="c22" value="Menulis catatan penolakan (wajib)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1315.0" y="1297.5" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="c23" value="Status DISETUJUI; tindakan asli dijalankan atas nama Admin pengaju, semua aturan diperiksa ulang" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="475.0" y="1289.8" width="270.0" height="64.5" as="geometry"/></mxCell><mxCell id="c24" value="Berhasil dijalankan?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="490.0" y="1384.0" width="240.0" height="60.0" as="geometry"/></mxCell><mxCell id="c25" value="Status GAGAL beserta pesan galat (data sudah berubah); Admin dapat mengajukan ulang" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="800.0" y="1381.8" width="240.0" height="64.5" as="geometry"/></mxCell><mxCell id="c26" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="595.0" y="1583.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c27" value="Menyimpan keputusan (DISETUJUI, DITOLAK, atau GAGAL) dan mencatat log PUTUSKAN_PERSETUJUAN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="475.0" y="1657.8" width="270.0" height="64.5" as="geometry"/></mxCell><mxCell id="c28" value="Menerima kabar di lonceng (Pembaruan) dan melihat status di Permintaan Saya" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="95.0" y="1757.5" width="270.0" he