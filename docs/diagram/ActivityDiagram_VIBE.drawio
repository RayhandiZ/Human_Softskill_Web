 per akun: 1 tautan per menit dan 5 per jam. Akun Admin dan Super Admin tidak dikirimi tautan. Hanya hash token yang disimpan (tabel ResetSandi)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1035.0" y="490.8" width="250.0" height="80.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="AD-03" id="hal2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1430" pageHeight="2234" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b&gt;AD-03 — Dosen Mengunggah Rekap Nilai Kelas&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#475569"&gt;Dosen mengunggah rekap Excel kelasnya dan nilai biasa langsung tersimpan. Nilai untuk angkatan yang sudah selesai/disahkan atau aspek yang sudah final diajukan ke Super Admin.&lt;br&gt;&lt;font color="#64748B" style="font-size:12px"&gt;Rujukan kode: src/halaman/dosen/UnggahNilai.jsx, src/lib/unggahDosen.js, src/server/pengajuan.js (unggahNilaiDosen)&lt;/font&gt;&lt;/font&gt;' style="text;html=1;fontSize=24;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="18.0" width="1370.0" height="86.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Dosen&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#CCFBF1;swimlaneFillColor=#F0FDFA;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="112.0" width="360.0" height="2092.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sistem VIBE&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390.0" y="112.0" width="680.0" height="2092.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Super Admin&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FFE4E6;swimlaneFillColor=#FFF1F2;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1070.0" y="112.0" width="330.0" height="2092.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;html=1;shape=startState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="198.0" y="206.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="c7" value="Membuka menu Unggah Nilai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="92.0" y="288.0" width="236.0" height="44.0" as="geometry"/></mxCell><mxCell id="c8" value="Mengunduh templat nilai (.xlsx)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="92.0" y="380.0" width="236.0" height="44.0" as="geometry"/></mxCell><mxCell id="c9" value="Membuat templat: NIM sebagai teks, kolom tugas, dan nilai yang sudah tersimpan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="450.0" y="461.8" width="260.0" height="64.5" as="geometry"/></mxCell><mxCell id="c10" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="195.0" y="571.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c11" value="Mengisi atau memperbaiki nilai di Excel, lalu mengunggah berkas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="85.0" y="653.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c12" value="Berkas .xlsx/.csv, maks. 5 MB?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12