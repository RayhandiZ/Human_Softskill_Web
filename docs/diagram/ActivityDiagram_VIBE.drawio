ver/sertifikat.js, src/lib/rules.js (kelayakanSertifikat), src/lib/duaLapis.js&lt;/font&gt;&lt;/font&gt;' style="text;html=1;fontSize=24;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="18.0" width="1860.0" height="86.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Mahasiswa&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#DBEAFE;swimlaneFillColor=#EFF6FF;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="112.0" width="420.0" height="2184.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sistem VIBE&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="450.0" y="112.0" width="640.0" height="2184.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Admin (lapis 1)&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FEF3C7;swimlaneFillColor=#FFFBEB;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1090.0" y="112.0" width="330.0" height="2184.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Super Admin (lapis 2)&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FFE4E6;swimlaneFillColor=#FFF1F2;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420.0" y="112.0" width="470.0" height="2184.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="ellipse;html=1;shape=startState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="158.0" y="206.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="c8" value="Membuka halaman Sertifikat" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="60.0" y="288.0" wi