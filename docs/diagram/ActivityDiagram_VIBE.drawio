value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="Jenis permintaan yang digerbang: UBAH_BOBOT, UBAH_PENILAIAN, KELOLA_ASPEK, UBAH_PENGUNCIAN (tanda final), KUNCI_ANGKATAN, AKSES_DATA_MASTER, serta PERBAIKAN_NILAI_DOSEN yang diajukan Dosen (AD-03)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#92400E;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100.0" y="408.0" width="400.0" height="80.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="AD-07" id="hal6"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2418" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b&gt;AD-07 — Input / Import Nilai dan Rollback Batch (Super Admin)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:14px" color="#475569"&gt;Satu penyimpanan menjadi satu Batch. Rollback menandai batch DIBATALKAN lalu memutar ulang nilai tiap sel dari AuditLog, jadi batch sesudahnya tidak ikut terhapus.&lt;br&gt;&lt;font color="#64748B" style="font-size:12px"&gt;Rujukan kode: src/halaman/admin/NilaiMahasiswa.jsx, src/lib/ingest.js, src/server/nilai.js (simpanBatch, rollbackBatch)&lt;/font&gt;&lt;/font&gt;' style="text;html=1;fontSize=24;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="18.0" width="1140.0" height="86.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Super Admin&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#FFE4E6;swimlaneFillColor=#FFF1F2;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30.0" y="112.0" width="480.0" height="2276.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Sistem VIBE&lt;/b&gt;" style="swimlane;html=1;startSize=46;fillColor=#E2E8F0;swimlaneFillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;horizontal=1;collapsible=0;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510.0" y="112.0" width="660.0" height="2276.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="ellipse;html=1;shape=startState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="258.0" y="206.0" width="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="c6" value="Membuka menu Input &amp;amp; Import Nilai" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="152.0" y="288.0" width="236.0" height="44.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="255.0" y="387.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c8" value="Memilih semester, sumber (PDP/MK), angkatan, dan program studi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="145.0" y="469.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c9" value="Angkatan sudah sampai semester itu?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="565.0" y="552.3" width="250.0" height="67.4" as="geometry"/></mxCell><mxCell id="c10" value="Menampilkan peringatan; semester itu belum bisa diisi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="885.0" y="561.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="255.0" y="663.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c12" value="Cara input?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="170.0" y="740.0" width="200.0" height="60.0" as="geometry"/></mxCell><mxCell id="c13" value="Mengisi tabel mahasiswa × komponen (0–100); sel kosong tetap kosong" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="45.0" y="829.8" width="210.0" height="64.5" as="geometry"/></mxCell><mxCell id="c14" value="Mengunggah Excel/CSV (format baku atau rekap mentah dosen)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="285.0" y="837.5" width="210.0" height="49.0" as="geometry"/></mxCell><mxCell id="c15" value="Mengenali kolom (Yakin / Perlu dicek) dan mengonversi skala 0–4, 0–10, 0–100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="560.0" y="921.8" width="260.0" height="64.5" as="geometry"/></mxCell><mxCell id="c16" value="Memeriksa atau mengubah pemetaan kolom, lalu 'Isi otomatis'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="285.0" y="1013.8" width="210.0" height="64.5" as="geometry"/></mxCell><mxCell id="c17" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="255.0" y="1123.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c18" value="Menulis alasan perubahan (wajib bila menyentuh data terkunci), lalu menekan Simpan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="130.0" y="1197.8" width="280.0" height="64.5" as="geometry"/></mxCell><mxCell id="c19" value="Memeriksa ulang tiap baris: NIM, komponen sesuai sumber &amp;amp; semester, nilai 0–100, tidak ganda, angkatan &amp;amp; prodi sasaran" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="540.0" y="1289.8" width="300.0" height="64.5" as="geometry"/></mxCell><mxCell id="c20" value="Semua baris lolos?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="570.0" y="1384.0" width="240.0" height="60.0" as="geometry"/></mxCell><mxCell id="c21" value="Menolak seluruh batch dan menunjukkan baris yang salah" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="885.0" y="1389.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c22" value="Data terkunci tanpa alasan ≥ 10 karakter?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="550.0" y="1472.3" width="280.0" height="67.4" as="geometry"/></mxCell><mxCell id="c23" value="Menolak: alasan perubahan wajib diisi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="885.0" y="1484.0" width="250.0" height="44.0" as="geometry"/></mxCell><mxCell id="c24" value="Menulis Batch (DIPROSES), nilai terbaru di tabel Nilai, dan tiap perubahan sel di AuditLog" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="555.0" y="1565.8" width="270.0" height="64.5" as="geometry"/></mxCel