th="24.0" height="24.0" as="geometry"/></mxCell><mxCell id="c7" value="Membuka halaman Angkatan dan memilih angkatan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="105.0" y="285.5" width="250.0" height="49.0" as="geometry"/></mxCell><mxCell id="c8" value="Menekan 'Sahkan angkatan'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="105.0" y="380.0" width="250.0" height="44.0" as="geometry"/></mxCell><mxCell id="c9" value="Menyusun pratinjau: jumlah mahasiswa, yang berhak / tidak berhak sertifikat, komponen kosong" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="475.0" y="461.8" width="270.0" height="64.5" as="geometry"/></mxCell><mxCell id="c10" value="Boleh disahkan?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="490.0" y="556.0" width="240.0" height="60.0" as="geometry"/></mxCell><mxCell id="c11" value="Menampilkan alasan: belum lewat Semester 3 atau belum punya mahasiswa" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="800.0" y="553.8" width="240.0" height="64.5" as="geometry"/></mxCell><mxCell id="c12" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="906.0" y="664.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c13" value="Membaca pratinjau, mengetik label angkatan sebagai konfirmasi (Admin juga menulis alasan)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="90.0" y="645.8" width="280.0" height="64.5" as="geometry"/></mxCell><mxCell id="c14" value="Pengirim Super Admin?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="490.0" y="736.3" width="240.0" height="67.4" as="geometry"/></mxCell><mxCell id="c15" value="Menyimpan PermintaanAdmin KUNCI_ANGKATAN (MENUNGGU); log AJUKAN_PERSETUJUAN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="800.0" y="737.8" width="240.0" height="64.5" as="geometry"/></mxCell><mxCell id="c16" value="Memutuskan permintaan (lihat AD-06)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1080.0" y="837.5" width="200.0" height="49.0" as="geometry"/></mxCell><mxCell id="c17" value="Disetujui?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="1090.0" y="924.0" width="180.0" height="60.0" as="geometry"/></mxCell><mxCell id="c18" value="Ditolak: angkatan tetap aktif" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="1275.0" y="1021.5" width="150.0" height="49.0" as="geometry"/></mxCell><mxCell id="c19" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1336.0" y="1124.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c20" value="" style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="595.0" y="1031.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="c21" value="Konfirmasi cocok dan masih boleh disahkan?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#1E293B;spacing=8;" vertex="1" parent="1"><mxGeometry x="470.0" y="1104.3" width="280.0" height="67.4" as="geometry"/></mxCell><mxCell id="c22" value="Menolak dengan pesan (lewat persetujuan: permintaan menjadi GAGAL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="800.0" y="1105.8" width="240.0" height="64.5" as="geometry"/></mxCell><mxCell id="c23" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="906.0" y="1216.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c24" value="Status angkatan TERKUNCI; menyimpan dikunciOleh, dikunciPada, dan daftar aspek aktif (aspekSaatKunci)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="475.0" y="1197.8" width="270.0" height="64.5" as="geometry"/></mxCell><mxCell id="c25" value="Mencatat log KUNCI_ANGKATAN beserta ringkasan pratinjau" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="475.0" y="1297.5" width="270.0" height="49.0" as="geometry"/></mxCell><mxCell id="c26" value="Melihat angkatan berstatus 'disahkan'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=13;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="105.0" y="1392.0" width="250.0" height="44.0" as="geometry"/></mxCell><mxCell id="c27" value="" style="ellipse;html=1;shape=endState;fillColor=#1E293B;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="216.0" y="1492.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#1E293B;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"