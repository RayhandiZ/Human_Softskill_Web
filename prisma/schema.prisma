// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Peran          { 
  MAHASISWA 
  DOSEN 
  ADMIN
  SUPER_ADMIN   // wewenang tertinggi: semua wewenang ADMIN + memutuskan permintaan admin; diisi lewat seed/basis data
  }

enum Sumber         { 
  PDP 
  MK 
  ENGAGEMENT 
  }

enum StatusBatch    { 
  DIPROSES 
  DIBATALKAN 
  DIKUNCI 
  }

enum StatusKunci    { 
  FINAL 
  SEMENTARA 
  }

enum StatusPersetujuan {
   MENUNGGU 
   DISETUJUI 
   DITOLAK 
   }
enum StatusPermintaan {         // permintaan admin kepada super admin
  MENUNGGU
  DISETUJUI
  DITOLAK
  DIBATALKAN                    // ditarik admin sebelum diputuskan
  GAGAL                         // disetujui, tetapi tidak bisa dijalankan (mis. datanya sudah berubah)
  }
enum StatusKoreksi {            // pengajuan ubah nilai dua lapis (rapat 24 Okt 2026): admin lalu super admin
  MENUNGGU_ADMIN
  MENUNGGU_SUPERADMIN
  DISETUJUI                     // disetujui super admin; nilainya sudah diterapkan
  DITOLAK
  }
enum StatusSertifikat {         // akses cetak sertifikat dua lapis: admin lalu super admin
  MENUNGGU_ADMIN
  MENUNGGU_SUPERADMIN
  SIAP_DICETAK
  DITOLAK
  DICABUT                       // akses yang sudah disetujui ditarik admin atau super admin, misalnya karena laporan sikap
  }
enum StatusAngkatan {
  AKTIF 
  TERKUNCI 
  }
enum SemesterAkad   { 
  GANJIL 
  GENAP 
  }

model Pengguna {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  peran        Peran
  aktif        Boolean    @default(true)
  kelolaMaster Boolean    @default(false) // izin dari super admin untuk menambah/mengubah data master (src/server/akses.js)
  notifDibacaId Int?      // id LogAktivitas terakhir yang ditandai dibaca di lonceng admin (src/server/notifikasi.js)
  dibuat       DateTime   @default(now())
  mahasiswa    Mahasiswa?
  dosen        Dosen?
  profil       Profil?
  aksesAngkatan AdminAngkatan[] // angkatan yang dibuka atau dinonaktifkan super admin untuk admin biasa ini
}

model Profil {                 // data milik pengguna sendiri (profil.js)
  penggunaId Int     @id
  telepon    String? 
  ponsel     String?
  alamat     String? @db.VarChar(500)
  foto       String? @db.LongText
  fotoSumber String? @db.LongText
  pengguna   Pengguna @relation(fields: [penggunaId], references: [id])
}

model Fakultas {
  id    Int            @id @default(autoincrement())
  nama  String         @unique
  prodi ProgramStudi[]
}

model ProgramStudi {
  id          Int         @id @default(autoincrement())
  nama        String      @unique
  jenjang     String      @db.VarChar(2)   // S1 | D3
  fakultasId  Int
  fakultas    Fakultas    @relation(fields: [fakultasId], references: [id])
  mahasiswa   Mahasiswa[]
  dosen       Dosen[]
}

model Angkatan {
  id              String         @id          // '2026', '2025B', '2025', '2024'
  tahun           Int
  label           String
  periodeTahun    String                      // '2025/2026'
  periodeSemester SemesterAkad
  status          StatusAngkatan @default(AKTIF)
  dikunciOleh     Int?                        // pengguna admin yang mengunci
  dikunciPada     DateTime?
  aspekSaatKunci  Json?                       // ID aspek aktif saat dikunci; transkrip angkatan terkunci memakai daftar ini
  mahasiswa       Mahasiswa[]
  dosen           DosenAngkatan[]
  aksesAdmin      AdminAngkatan[]
}

model Mahasiswa {
  id         Int          @id @default(autoincrement())
  nim        String       @unique
  nama       String
  penggunaId Int          @unique
  prodiId    Int
  angkatanId String
  pengguna   Pengguna     @relation(fields: [penggunaId], references: [id])
  prodi      ProgramStudi @relation(fields: [prodiId], references: [id])
  angkatan   Angkatan     @relation(fields: [angkatanId], references: [id])
  nilai      Nilai[]
  penguncian Penguncian[]
  koreksi    PengajuanKoreksi[]
  pengumpulan Pengumpulan[]
  sertifikat PermintaanSertifikat[]
  @@index([angkatanId, prodiId])
}

model Dosen {
  id         Int          @id @default(autoincrement())
  nip        String       @unique
  nama       String
  jabatan    String
  sumber     Sumber
  semester   Int
  penggunaId Int          @unique
  prodiId    Int
  pengguna   Pengguna     @relation(fields: [penggunaId], references: [id])
  prodi      ProgramStudi @relation(fields: [prodiId], references: [id])
  angkatan   DosenAngkatan[]
}

model DosenAngkatan {           // angkatan yang diampu seorang dosen; tanpa baris, kelasnya angkatan yang sedang di semesternya
  dosenId    Int
  angkatanId String
  dosen      Dosen    @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  angkatan   Angkatan @relation(fields: [angkatanId], references: [id], onDelete: Cascade)
  @@id([dosenId, angkatanId])
  @@index([angkatanId])
}

model AdminAngkatan {           // akses angkatan seorang admin biasa yang diatur super admin, menimpa bawaannya: tanpa baris,
                                // angkatan Semester 1–3 terlihat dan angkatan yang sudah lewat tersembunyi (lihat muat.js)
  penggunaId Int
  angkatanId String
  terlihat   Boolean            // true = angkatan lewat Semester 3 yang dibuka; false = angkatan Semester 1–3 yang dinonaktifkan
  olehId     Int                // super admin yang mengaturnya; alasannya di LogAktivitas (UBAH_AKSES_ANGKATAN)
  waktu      DateTime @default(now())
  pengguna   Pengguna @relation(fields: [penggunaId], references: [id], onDelete: Cascade)
  angkatan   Angkatan @relation(fields: [angkatanId], references: [id], onDelete: Cascade)
  @@id([penggunaId, angkatanId])
  @@index([angkatanId])
}

model Komponen {                // sumber daftar tugas tiap aspek; isi awalnya ditanam seed dari curriculum.js
  id         String    @id                    // 'A1-MK-T1'; tidak pernah diganti, dipakai nilai dan riwayat
  aspekId    String                           // 'A1' (tanpa FK, aspek hidup di kode)
  sumber     Sumber
  label      String
  jenis      String?                          // TUGAS | SIKAP | UTS | UAS
  ranah      String    @default("kognitif") @db.VarChar(10)   // kognitif | afektif
  resmi      Boolean   @default(true)
  bobot      Float?                           // kosong = ikut CONFIG.MODE_BOBOT_KOMPONEN
  urutan     Int       @default(0)
  aktif      Boolean   @default(true)         // false = diarsipkan: tidak tampil, tidak dihitung, nilainya tetap
  diubahOleh Int?
  diubahPada DateTime?
  nilai      Nilai[]
}

model Aspek {                   // aspek CPMK yang diubah atau ditambah dari layar; aspek tanpa baris memakai isi curriculum.js
  id         String    @id @db.VarChar(10)   // 'A1' ... 'C2', atau aspek baru ('C3'); tidak pernah diganti
  nama       String
  deskripsi  String    @db.Text
  pdp        String?
  mk         String?
  engagement String?
  kode       String?   @db.VarChar(10)       // kode tampilan 'A.1.'; kosong = bawaan curriculum.js
  cluster    String?   @db.VarChar(10)       // 'CL1' ... 'CL6'; area dan fase ikut cluster; kosong = bawaan
  semester   Int?                            // 1 ... 3; kosong = bawaan (A3/C1 dari config.js)
  aktif      Boolean   @default(true)        // false = diarsipkan: tidak tampil, tidak dihitung, nilainya tetap
  diubahOleh Int?
  diubahPada DateTime?
}

model Indikator {               // indikator perilaku per aspek; tampil di transkrip, tidak ikut dihitung
  id         String    @id @db.VarChar(40)    // 'A1-IND-1'
  aspekId    String    @db.VarChar(10)
  label      String
  ranah      String    @db.VarChar(10)        // kognitif | afektif
  sumber     Json                             // daftar bukti (larik teks), sama dengan INDIKATOR.sumber di kode
  urutan     Int       @default(0)
  diubahOleh Int?
  diubahPada DateTime?
  @@index([aspekId])
}

model Batch {
  id         String      @id          // 'B-2026-0001'
  sumber     Sumber
  semester   Int
  angkatanId String
  aktorId    Int
  cara       String                   // manual | import | rekap
  status     StatusBatch @default(DIPROSES)
  waktu      DateTime    @default(now())
  nilai      Nilai[]
  audit      AuditLog[]
}

model Nilai {                   // nilai SAAT INI per (mahasiswa, komponen)
  id          Int       @id @default(autoincrement())
  mahasiswaId Int
  komponenId  String
  nilai       Float                   // 0–100
  penilaiId   Int
  batchId     String?
  diperbarui  DateTime  @updatedAt
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  komponen    Komponen  @relation(fields: [komponenId], references: [id])
  batch       Batch?    @relation(fields: [batchId], references: [id])
  @@unique([mahasiswaId, komponenId])
}

model AuditLog {                // append-only, jangan pernah di-update/delete
  id          Int      @id @default(autoincrement())
  waktu       DateTime @default(now())
  aktorId     Int
  mahasiswaId Int
  komponenId  String
  nilaiLama   Float?
  nilaiBaru   Float?
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id])
  @@index([mahasiswaId])
  @@index([waktu])                                       // halaman Log: urut dan saring menurut waktu
  @@index([aktorId])                                     // halaman Log: saring menurut pelaku
}

model LogAktivitas {            // catatan tindakan admin selain nilai (kunci angkatan, ubah data terkunci, penguncian)
  id      Int      @id @default(autoincrement())
  waktu   DateTime @default(now())
  aktorId Int
  aksi    String   @db.VarChar(60)    // KUNCI_ANGKATAN | UBAH_DATA_TERKUNCI | ROLLBACK_DATA_TERKUNCI | UBAH_PENGUNCIAN
  target  String   @db.VarChar(120)   // 'angkatan 2024', 'batch B-...', 'mahasiswa 0000...'
  rincian Json?
  @@index([waktu])
  @@index([aksi])
}

model Penguncian {              // keputusan final/sementara per aspek
  mahasiswaId Int
  aspekId     String
  status      StatusKunci
  olehId      Int
  waktu       DateTime  @default(now())
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  @@id([mahasiswaId, aspekId])
}

model PengajuanKoreksi {         // mahasiswa mengajukan, admin meneruskan (lapis 1), super admin menerapkan (lapis 2)
  id              Int               @id @default(autoincrement())
  mahasiswaId     Int
  komponenId      String
  alasan          String            @db.Text
  nilaiDiharapkan Float?
  status          StatusKoreksi     @default(MENUNGGU_ADMIN)
  diajukan        DateTime          @default(now())
  adminOleh       Int?                       // lapis 1: admin yang meneruskan
  adminPada       DateTime?
  adminCatatan    String?           @db.Text
  nilaiUsulan     Float?                     // nilai yang diteruskan admin ke super admin
  diputuskanOleh  Int?                       // keputusan akhir: super admin yang menyetujui, atau siapa pun yang menolak
  diputuskanPada  DateTime?
  catatan         String?           @db.Text
  batchId         String?                    // batch yang menerapkan nilai barunya
  mahasiswa       Mahasiswa         @relation(fields: [mahasiswaId], references: [id])
}

model PermintaanSertifikat {     // mahasiswa yang layak meminta akses cetak; admin lalu super admin menyetujui
  id          Int              @id @default(autoincrement())
  mahasiswaId Int
  status      StatusSertifikat @default(MENUNGGU_ADMIN)
  diajukan    DateTime         @default(now())
  adminOleh   Int?                          // lapis 1
  adminPada   DateTime?
  superOleh   Int?                          // lapis 2
  superPada   DateTime?
  ditolakOleh Int?
  ditolakPada DateTime?
  catatan     String?          @db.Text     // alasan penolakan
  dicabutOleh Int?                          // pencabutan sesudah SIAP_DICETAK
  dicabutPada DateTime?
  alasanCabut String?          @db.Text
  jumlahCetak Int              @default(0)  // berapa kali dibuka untuk dicetak, oleh mahasiswa atau admin
  cetakTerakhir     DateTime?
  cetakTerakhirOleh Int?
  mahasiswa   Mahasiswa        @relation(fields: [mahasiswaId], references: [id])
  @@index([status])
  @@index([mahasiswaId])
}

model Pengumpulan {             // berkas yang dikirim mahasiswa ke dosen
  id          Int       @id @default(autoincrement())
  mahasiswaId Int
  komponenId  String
  dosenId     Int
  bentuk      String                  // PDF | DOCX | Tautan Drive
  berkas      String                  // path file atau URL
  waktu       DateTime  @default(now())
  terlambat   Boolean   @default(false)
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  @@unique([mahasiswaId, komponenId])
}

model Usulan {                  // dosen mengusulkan, admin menyetujui (R8)
  id               Int               @id @default(autoincrement())
  dosenId          Int
  cara             String
  catatan          String?           @db.Text
  status           StatusPersetujuan @default(MENUNGGU)
  waktu            DateTime          @default(now())
  batchId          String?                  // terisi setelah disetujui
  diputuskanOleh   Int?
  diputuskanPada   DateTime?
  catatanKeputusan String?           @db.Text
  ditolakSistem    Json?                    // baris yang tidak lolos pemeriksaan saat disetujui
  entri            UsulanEntri[]
}

model UsulanEntri {
  id         Int    @id @default(autoincrement())
  usulanId   Int
  nim        String
  komponenId String
  nilai      Float
  usulan     Usulan @relation(fields: [usulanId], references: [id], onDelete: Cascade)
}

model PermintaanAdmin {         // admin meminta, super admin menyetujui; pola yang sama dengan Usulan dosen
  id               Int              @id @default(autoincrement())
  aksi             String           @db.VarChar(60)   // 'UBAH_BOBOT', 'KUNCI_ANGKATAN', ...
  isi              Json                               // isi permintaan persis seperti dikirim ke pintu API
  ringkasan        Json?                              // bahan bacaan super admin, mis. dampak perubahan
  alasan           String?          @db.Text
  status           StatusPermintaan @default(MENUNGGU)
  diajukanOleh     Int
  diajukanPada     DateTime         @default(now())
  diputuskanOleh   Int?
  diputuskanPada   DateTime?
  catatanKeputusan String?          @db.Text
  hasil            Json?                              // hasil saat dijalankan, atau pesan galat bila GAGAL
  @@index([status])
  @@index([diajukanPada])
}

model Konfigurasi {             // pengaturan yang menimpa bawaan CONFIG di config.js, plus penanda VERSI_KURIKULUM
  kunci String @id              // 'AMBANG_SERTIFIKAT', 'VERSI_KURIKULUM'
  nilai Json
}
